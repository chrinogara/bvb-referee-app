# Client-side variables (safe to expose in the browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_RESEND_API_KEY=your-resend-api-key
VITE_GHYSEL_EMAIL=maarten.ghysel@volleyvlaanderen.be

# NOTE: The Anthropic/Claude API key is NO LONGER a Vite variable.
# It must NOT be exposed in the browser. Set it as a Supabase secret instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# It is read server-side by the `translate-with-claude` Edge Function.
